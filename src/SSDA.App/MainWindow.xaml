<Window x:Class="SSDA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SSDA.App.ViewModels"
        xmlns:views="clr-namespace:SSDA.App.Views"
        xmlns:cnv="clr-namespace:SSDA.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="SSDA"
        Width="1080" Height="680" MinWidth="820" MinHeight="520"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource TextFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <cnv:EnumEqualsToBooleanConverter x:Key="EnumEqualsToBool" />
        <cnv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!--  ─── Title bar ───  -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Style="{StaticResource LabelTextBlock}" Text="SSDA" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToAccountsCommand}">
                    <Button.Content>
                        <TextBlock Style="{StaticResource LabelTextBlock}" Text="ГЛАВНЫЙ" />
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource NavButton}"
                        Command="{Binding NavigateToConfirmationsCommand}">
                    <Button.Content>
                        <TextBlock Style="{StaticResource LabelTextBlock}" Text="ПОДТВЕРЖДЕНИЯ" />
                    </Button.Content>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Click="Min_Click"
                        Content="–" FontSize="14" />
                <Button Style="{StaticResource TitleBarButton}" Click="Max_Click"
                        Content="▢" FontSize="11" />
                <Button Style="{StaticResource TitleBarButton}" Click="Close_Click"
                        Content="✕" FontSize="11" />
            </StackPanel>
        </Grid>

        <!--  ─── Body ───  -->
        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Border Background="Transparent"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SurfaceCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:AccountsView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePage}" Value="Confirmations">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:ConfirmationsView DataContext="{Binding ConfirmationsVm}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!--  Lock overlay for encrypted manifests.  -->
                    <ContentControl Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:PassphraseView DataContext="{Binding PassphraseVm}" />
                    </ContentControl>

                    <!--  Re-login overlay  -->
                    <ContentControl Visibility="{Binding LoginVm.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:LoginView DataContext="{Binding LoginVm}" />
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!--  ─── Status bar ───  -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyMutedTextBlock}"
                           FontSize="11"
                           Text="{Binding StatusText}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyMutedTextBlock}"
                           FontSize="10"
                           Text="v0.1 · stage 1 · core ready" />
            </Grid>
        </Border>
    </Grid>
</Window>
