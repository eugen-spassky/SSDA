<UserControl x:Class="SSDA.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SSDA.App.ViewModels"
             xmlns:c="clr-namespace:SSDA.App.Controls"
             xmlns:cnv="clr-namespace:SSDA.App.Converters"
             d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <cnv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ─── Sidebar ───  -->
        <Border Grid.Column="0"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,1,0"
                Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="6,0,6,12">
                    <TextBlock Style="{StaticResource LabelTextBlock}" Text="ACCOUNTS" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Style="{StaticResource GlassListBox}"
                         ItemContainerStyle="{StaticResource GlassListBoxItem}"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                            <Grid Margin="8,8,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceElev2Brush}"
                                        Width="32" Height="32"
                                        CornerRadius="999"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource SmallFontFamily}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource BodyTextBlock}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SteamIdText}"
                                               Style="{StaticResource BodyMutedTextBlock}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2"
                        Style="{StaticResource GlassButton}"
                        HorizontalAlignment="Stretch"
                        Margin="6,12,6,0"
                        Content="+  ADD ACCOUNT"
                        IsEnabled="False"
                        ToolTip="Привязка авторизатора будет в следующем PR." />
            </Grid>
        </Border>

        <!--  ─── Right pane ───  -->
        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource H1TextBlock}"
                           Text="{Binding SelectedAccount.DisplayName, FallbackValue='Нет аккаунтов'}" />
                <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                           Margin="0,4,0,0"
                           Text="{Binding SelectedAccount.SteamIdText, FallbackValue=''}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <c:RingTimer Grid.Column="0"
                             Width="120" Height="120"
                             Progress="{Binding CodeVm.Progress}"
                             Seconds="{Binding CodeVm.SecondsRemaining}" />

                <StackPanel Grid.Column="1"
                            Margin="32,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource LabelTextBlock}"
                               Text="STEAM GUARD CODE" />
                    <TextBlock Style="{StaticResource CodeDisplayTextBlock}"
                               Margin="0,8,0,16"
                               Text="{Binding CodeVm.Code}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GlassPrimaryButton}"
                                Content="COPY CODE"
                                Command="{Binding CodeVm.CopyCommand}"
                                IsEnabled="{Binding CodeVm.HasAccount}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource GlassButton}"
                                Content="LOCK"
                                Command="{Binding LockCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,32,0,0"
                    Background="{StaticResource SurfaceElev1Brush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SurfaceCornerRadius}"
                    Padding="20"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelTextBlock}"
                               Text="STATUS" />
                    <TextBlock Style="{StaticResource BodySecondaryTextBlock}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding StatusText}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
