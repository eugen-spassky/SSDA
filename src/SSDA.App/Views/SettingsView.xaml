<UserControl x:Class="SSDA.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SSDA.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource H1TextBlock}" Text="Настройки" />

                <!--  Import section  -->
                <Border Margin="0,24,0,0"
                        Background="{StaticResource SurfaceElev1Brush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SurfaceCornerRadius}"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelTextBlock}" Text="ИМПОРТ ИЗ ОРИГИНАЛЬНОГО SDA" />
                        <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12"
                                   Text="Перенесите аккаунты из Steam Desktop Authenticator. Укажите папку с manifest.json — формат maFile одинаковый, поэтому повторная привязка не нужна." />
                        <Button Style="{StaticResource GlassButton}"
                                HorizontalAlignment="Left"
                                Content="ВЫБРАТЬ MANIFEST.JSON"
                                Command="{Binding ImportCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Border>

                <!--  Autostart  -->
                <Border Margin="0,16,0,0"
                        Background="{StaticResource SurfaceElev1Brush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SurfaceCornerRadius}"
                        Padding="20">
                    <StackPanel>
                        <CheckBox Style="{StaticResource GlassCheckBox}"
                                  IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"
                                  Content="Запускать SSDA при входе в Windows" />
                        <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                                   TextWrapping="Wrap"
                                   Margin="22,4,0,0"
                                   FontSize="11"
                                   Text="Регистрирует приложение в HKCU\Software\Microsoft\Windows\CurrentVersion\Run. Без прав администратора." />
                    </StackPanel>
                </Border>

                <!--  Tray  -->
                <Border Margin="0,16,0,0"
                        Background="{StaticResource SurfaceElev1Brush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SurfaceCornerRadius}"
                        Padding="20">
                    <StackPanel>
                        <CheckBox Style="{StaticResource GlassCheckBox}"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Content="Сворачивать в трей вместо панели задач" />
                        <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                                   TextWrapping="Wrap"
                                   Margin="22,4,0,0"
                                   FontSize="11"
                                   Text="Закрытие окна по «✕» прячет приложение в системный трей. Полный выход — через меню в трее." />
                    </StackPanel>
                </Border>

                <!--  Status  -->
                <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
