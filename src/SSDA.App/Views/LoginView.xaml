<UserControl x:Class="SSDA.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SSDA.App.ViewModels"
             xmlns:cnv="clr-namespace:SSDA.App.Converters"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <cnv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <Grid Background="#80000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceElev2Brush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource SurfaceCornerRadius}"
                Padding="28"
                Width="420">
            <StackPanel>
                <TextBlock Style="{StaticResource H1TextBlock}" Text="Вход в Steam" />
                <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"
                           Text="Сессия аккаунта истекла. Введите пароль — 2FA-код будет сгенерирован автоматически из shared_secret." />
                <TextBlock Style="{StaticResource LabelTextBlock}"
                           Text="АККАУНТ" />
                <TextBlock Style="{StaticResource BodyTextBlock}"
                           Margin="0,4,0,12"
                           Text="{Binding Target.DisplayName}" />
                <TextBlock Style="{StaticResource LabelTextBlock}"
                           Text="ПАРОЛЬ" />
                <PasswordBox x:Name="PassBox"
                             Style="{StaticResource GlassPasswordBox}"
                             Margin="0,8,0,0"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                             KeyDown="PassBox_KeyDown" />
                <TextBlock Style="{StaticResource BodyTextBlock}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,8,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource GlassButton}"
                            Margin="0,0,8,0"
                            Content="ОТМЕНА"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource GlassPrimaryButton}"
                            Content="ВОЙТИ"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Click="Submit_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
