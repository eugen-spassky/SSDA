<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Segoe UI Variable falls back to Segoe UI if the variable family is not present.  -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="SmallFontFamily">Segoe UI Variable Small, Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, JetBrains Mono, monospace</FontFamily>

    <!--  H1 — large display, e.g. page title  -->
    <Style x:Key="H1TextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Body text  -->
    <Style x:Key="BodyTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodySecondaryTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BodyMutedTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!--  Section label — uppercase, tracked  -->
    <Style x:Key="LabelTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <!--  WPF 4.5+ supports kerning via Typography.* — we use letter spacing via TextElement.CharacterSpacing  -->
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!--  TOTP code display  -->
    <Style x:Key="CodeDisplayTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="RingNumberTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RingLabelTextBlock" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="9" />
    </Style>

</ResourceDictionary>
