<UserControl x:Class="SSDA.App.Views.LinkAuthenticatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SSDA.App.ViewModels"
             xmlns:cnv="clr-namespace:SSDA.App.Converters"
             d:DataContext="{d:DesignInstance vm:LinkAuthenticatorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <cnv:InverseBooleanConverter x:Key="InverseBool" />
        <cnv:EnumEqualsToVisibilityConverter x:Key="EnumVisible" />
    </UserControl.Resources>
    <Grid Background="#80000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceElev2Brush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource SurfaceCornerRadius}"
                Padding="28"
                Width="480">
            <StackPanel>
                <TextBlock Style="{StaticResource H1TextBlock}"
                           Text="Привязать авторизатор" />

                <!--  Step 1: Credentials  -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Credentials}">
                    <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="Введите имя пользователя и пароль Steam. К аккаунту НЕ должен быть привязан Steam Guard." />

                    <TextBlock Style="{StaticResource LabelTextBlock}" Text="ИМЯ ПОЛЬЗОВАТЕЛЯ" />
                    <TextBox Style="{StaticResource GlassTextBox}"
                             Margin="0,8,0,12"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Style="{StaticResource LabelTextBlock}" Text="ПАРОЛЬ" />
                    <PasswordBox x:Name="PassBox"
                                 Style="{StaticResource GlassPasswordBox}"
                                 Margin="0,8,0,0"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                 KeyDown="PassBox_KeyDown" />
                </StackPanel>

                <!--  Step 2: SMS  -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Sms}">
                    <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="Steam отправил SMS с активационным кодом на номер, привязанный к аккаунту. Введите его сюда." />

                    <TextBlock Style="{StaticResource LabelTextBlock}" Text="КОД ИЗ SMS" />
                    <TextBox x:Name="SmsBox"
                             Style="{StaticResource GlassTextBox}"
                             Margin="0,8,0,0"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="20"
                             MaxLength="10"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                             KeyDown="SmsBox_KeyDown" />
                </StackPanel>

                <!--  Step 3: Revocation  -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Revocation}">
                    <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="Авторизатор привязан. Сохраните код восстановления — он понадобится, если потеряете доступ к SSDA." />

                    <TextBlock Style="{StaticResource LabelTextBlock}" Text="REVOCATION CODE" />
                    <TextBlock Style="{StaticResource CodeDisplayTextBlock}"
                               Margin="0,4,0,0"
                               Text="{Binding RevocationCode}" />
                    <TextBlock Style="{StaticResource BodyMutedTextBlock}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Text="Запишите код в безопасное место. Без него вы НЕ сможете отвязать авторизатор от аккаунта." />
                </StackPanel>

                <!--  Step 4: Done  -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Done}">
                    <TextBlock Style="{StaticResource BodyTextBlock}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="Готово. Аккаунт добавлен в список и сразу доступен для генерации 2FA-кодов." />
                </StackPanel>

                <!--  Error  -->
                <TextBlock Style="{StaticResource BodyTextBlock}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,8,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />

                <!--  Action row  -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource GlassButton}"
                            Margin="0,0,8,0"
                            Content="ОТМЕНА"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Command="{Binding CancelCommand}" />

                    <!--  Step 1 next button  -->
                    <Button Style="{StaticResource GlassPrimaryButton}"
                            Content="ДАЛЕЕ"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Credentials}"
                            Click="Credentials_Click" />

                    <!--  Step 2 next button  -->
                    <Button Style="{StaticResource GlassPrimaryButton}"
                            Content="ПОДТВЕРДИТЬ"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Sms}"
                            Click="Sms_Click" />

                    <!--  Step 3 next button  -->
                    <Button Style="{StaticResource GlassPrimaryButton}"
                            Content="Я СОХРАНИЛ КОД"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Revocation}"
                            Command="{Binding RevocationAcknowledgedCommand}" />

                    <!--  Step 4 finish button  -->
                    <Button Style="{StaticResource GlassPrimaryButton}"
                            Content="ГОТОВО"
                            Visibility="{Binding Step, Converter={StaticResource EnumVisible}, ConverterParameter=Done}"
                            Command="{Binding FinishCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
